    "prefix": "cppmain",
    "body": [
      "#include <bits/stdc++.h>",
      "using namespace std;",
      "",
      "int main() {",
      "    ios::sync_with_stdio(false);",
      "    cin.tie(nullptr);",
      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "C++ main with fast IO setup"
  },

  "For Loop (i)": {
    "prefix": "fori",
    "body": [
      "for (int i = 0; i < ${1:N}; ++i) {",
      "    $0",
      "}"
