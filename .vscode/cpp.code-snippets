    "description": "Classic for-loop with index i"
  },

  "Range-based For": {
    "prefix": "forr",
    "body": [
      "for (auto &${1:elem} : ${2:container}) {",
      "    $0",
      "}"
    ],
    "description": "Range-based for loop"
  },

  "If-Else": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "} else {",
      "    ",
